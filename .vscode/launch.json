{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Node.js Backend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/server.ts"],
      "cwd": "${workspaceFolder}/nodejs-backend",
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/nodejs-backend/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
