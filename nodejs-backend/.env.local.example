# ══════════════════════════════════════════════════════════════════════════════
# Taskly Node.js Backend — LOCAL DEVELOPMENT .env
# Copy this file to .env and fill in your values:
#   cp .env.local.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Database (your local MySQL) ───────────────────────────────────────────────
# Make sure MySQL is running and you've imported the DB dump first.
# See LOCAL_SETUP.md for how to import the dump.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
DB_NAME=utilization
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT=30000
DB_IDLE_TIMEOUT=10000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate your own secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=8h

# ── Email (optional for local dev — emails are logged but not sent if empty) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taskly.com

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3030
APP_BASE_URL=http://localhost:8080

# ── Web Push VAPID (optional for local dev) ───────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@taskly.com
